#!/usr/bin/env bash
# Connect the Bluetooth speaker and print a *healthy* PipeWire sink node on
# stdout. "Healthy" means a short SILENT wav actually plays on it — this guards
# against the stuck-A2DP-transport bug, where the sink exists but audio times
# out (transport stays 'idle', sink SUSPENDED). Before connecting we proactively
# disconnect any BLOCKER_MACS (other speakers sharing the BT adapter): a blocker
# doesn't stop the target from connecting, but its contention corrupts the
# target's A2DP stream so it connects yet plays silence. If the probe still fails
# we restart the full PipeWire stack, bring EasyEffects back, reconnect, retry.
#
# Shared by start-music (nightly shuffle) and play-now (on-demand single track).
# On success: prints sink node name, exit 0. On failure: exit 1.
set -euo pipefail

# Resolve symlinks so sibling files (bt-assert, silence.wav, ...) resolve to the
# repo's host/ dir even when invoked via a /usr/local/bin symlink.
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# Load gitignored local config (SPEAKER_MAC, ...) if present.
[[ -f "$HERE/speaker.env" ]] && source "$HERE/speaker.env"

MAC="${SPEAKER_MAC:-AA:BB:CC:DD:EE:FF}"
# Other BT speakers that share the adapter and corrupt the target's A2DP stream
# while connected. Disconnected proactively (below) before we connect the target.
# Space-separated MACs, set in speaker.env.
BLOCKER_MACS="${BLOCKER_MACS:-}"
SILENCE="$HERE/silence.wav"

log() { echo "[ensure-sink] $*" >&2; }

# Connect the speaker, then prove the audio path works by playing silence.
# Echoes the resolved sink node name on stdout; non-zero if unhealthy.
connect_and_verify() {
  local sink
  sink="$("$HERE/bt-assert" "$MAC")" || return 1
  if paplay -d "$sink" "$SILENCE" >/dev/null 2>&1; then
    echo "$sink"
    return 0
  fi
  log "audio path unhealthy (silent probe failed on $sink)"
  return 2
}

# Proactively free the BT radio BEFORE connecting: a blocker speaker doesn't stop
# the target from connecting, it corrupts the target's A2DP stream so it plays
# silence. Disconnecting on a connect *failure* would never catch that, so do it
# up front, every startup. Best-effort; a no-op if the blocker isn't connected.
if [[ -n "${BLOCKER_MACS// }" ]]; then
  for blocker in $BLOCKER_MACS; do
    log "disconnecting blocker $blocker to free the BT radio"
    "$HERE/bt-disconnect" "$blocker" || true
  done
  sleep 2
fi

if SINK="$(connect_and_verify)"; then
  echo "$SINK"
  exit 0
fi

log "recovering: restarting PipeWire stack"
systemctl --user restart pipewire pipewire-pulse wireplumber
sleep 4
# The stack restart kills EasyEffects outright (process dies, its nodes vanish,
# its autostart unit goes to 'failed'), so relaunch it — the preset reapplies
# itself via the mic's autoload rule. Best-effort: a dead mic chain is bad, but
# it must never stop the music from starting.
"$HERE/ensure-easyeffects" || true

if SINK="$(connect_and_verify)"; then
  echo "$SINK"
  exit 0
fi

log "audio path still unhealthy after stack restart; giving up"
exit 1
