[Unit]
Description=Nighttime music playback (mpv to Bluetooth speaker)
# Audio + bluetooth need to be up; this is a user unit so the user PipeWire/
# WirePlumber session is already a dependency of the user manager.
After=bluetooth.target

[Service]
Type=simple
# The mpv IPC socket lives in the repo's run/ dir (always exists, so the Docker
# container can bind-mount it 24/7). start-music defaults there; override with
# MPV_SOCKET_DIR if the repo moves.
# SPEAKER_MAC is sourced from host/speaker.env by start-music (gitignored).
Environment=PLAYLIST=/home/littlemiss/Documents/dev/nightvibe/data/playlist.m3u
# VOLUME intentionally unset: start-music reads the persisted data/volume (the
# app's last-set value), falling back to 70. Set VOLUME here to force a fixed level.
ExecStart=/usr/local/bin/start-music
# At stop (08:00), free the speaker so the BT radio is available again.
ExecStopPost=/usr/local/bin/bt-disconnect
# bt-assert can fail if the speaker is off at 23:00; keep retrying so it starts
# whenever the speaker comes online (within the 23:00-08:00 window).
#
# Restart=always, not on-failure: when the A2DP transport drops mid-night
# (wireplumber logs "Failure in Bluetooth audio transport"), mpv loses its audio
# device and exits *successfully* — so on-failure never fired and the night just
# went silent until 08:00 (this is what happened 2026-09-20 at 23:26). An explicit
# `systemctl stop` (how music-stop.service ends the night at 08:00) still never
# triggers a restart, so always is safe here.
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
