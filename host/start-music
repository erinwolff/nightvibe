#!/usr/bin/env bash
# Get a healthy Bluetooth sink (ensure-sink: connect + health-check + recovery),
# then exec mpv on the shuffle pool. Using `exec` makes this script *become*
# mpv, so the 08:00 stop signal hits mpv directly with no wrapper in between.
#
# Run by music-night.service — both the nightly timer AND on-demand "start
# shuffle now" (start-shuffle) route through that same service, so this is the
# single owner of shuffle playback.
set -euo pipefail

# Resolve symlinks so sibling scripts resolve to the repo's host/ dir even when
# invoked via the /usr/local/bin symlink.
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# Load gitignored local config (SPEAKER_MAC, ...) if present.
[[ -f "$HERE/speaker.env" ]] && source "$HERE/speaker.env"

MAC="${SPEAKER_MAC:-AA:BB:CC:DD:EE:FF}"
PLAYLIST="${PLAYLIST:-/home/littlemiss/Documents/dev/nightvibe/data/playlist.m3u}"

# Volume persists across nights: the app writes the last-set value to data/volume
# (app/main._save_volume); launch mpv at it. An explicit VOLUME env still wins.
VOL_FILE="${VOLUME_FILE:-$(cd "$HERE/.." && pwd)/data/volume}"
DEFAULT_VOLUME=70
if [[ -r "$VOL_FILE" ]]; then
  read -r v < "$VOL_FILE" || v=""
  [[ "$v" =~ ^[0-9]+$ ]] && ((v <= 130)) && DEFAULT_VOLUME="$v"
fi
VOLUME="${VOLUME:-$DEFAULT_VOLUME}"

# Socket lives in a project-local run/ dir that always exists (so the Docker
# container can bind-mount it 24/7, even while mpv isn't running). Override with
# MPV_SOCKET_DIR.
SOCK_DIR="${MPV_SOCKET_DIR:-$(cd "$HERE/.." && pwd)/run}"
SOCK="$SOCK_DIR/mpv.sock"

log() { echo "[start-music] $*" >&2; }

mkdir -p "$SOCK_DIR"
rm -f "$SOCK"

if ! SINK="$(SPEAKER_MAC="$MAC" "$HERE/ensure-sink")"; then
  log "no healthy sink; failing so the service retries"
  exit 1
fi
log "audio path healthy, sink=$SINK"

# mpv 0.34 has no native pipewire AO; route through PipeWire's pulse-compat layer
# with an explicit device so we never fight the system default sink.
#
# --af: two stages, and the reason the app's volume slider used to wreck the sound.
#
# 1. dynaudnorm — the real fix. This pool is mastered both QUIETLY and UNEVENLY:
#    measured 2026-09-21, integrated loudness runs -21.3 LUFS (Au Ralenti) to
#    -11.5 LUFS (Among the Nebulae), a ~10 dB spread, while the loud tracks
#    already true-peak at ~0 dBFS. So there was no headroom to give: turning the
#    speaker up ran out, and the app's slider is a PEAK gain, which just clipped.
#    dynaudnorm raises the *average* per track and leaves peaks alone — the quiet
#    tracks come up ~7.6 dB and the spread closes to ~3.4 dB.
#    Settings are ffmpeg defaults (f=500:g=31) plus p=0.9:m=8:s=12, chosen by
#    measuring loudness range: they keep the most dynamics (LRA 7.9/5.1) of the
#    variants tried, which matters for music that plays while she's asleep —
#    punchier settings (f=250:g=15:s=5) are louder but crush LRA to 6.4/2.4.
#
# 2. alimiter — backstop. mpv's volume curve is CUBIC, so --volume=130 is not
#    +30% but (1.3^3) = 2.2x = +6.9 dB. That drove peaks to +5.6 dBFS and hard-
#    clipped every track in the pool (all 39 peak above -6.9 dBFS) — heard as
#    crackling/breakup, not as "louder". The limiter catches peaks at -1 dBFS so
#    no volume the app can set will clip again. level=false stops alimiter from
#    re-normalising back up to full scale.
#
# Both keep the native 44.1 kHz — unlike loudnorm, which forces mpv into an
# internal 192 kHz resample.
#
# --no-input-terminal + --msg-level=all=error,ao=v replaces --no-terminal, which
# silenced mpv completely. The stutter reported 2026-09-19..22 leaves no trace in
# any log, so this lets the audio-output layer speak up (underruns, device errors)
# into the journal under music-night.service, while staying quiet otherwise —
# measured at 11 lines at startup and nothing after. Do NOT use --log-file: it is
# pinned to debug level and wrote ~3k lines for a 3-second clip.
# Caveat: if the dropout is on the RF side, PipeWire keeps feeding the sink happily
# and mpv may never see an underrun — absence here is not proof the link was fine.
exec mpv --ao=pulse \
  --audio-device="pulse/$SINK" \
  --shuffle --loop-playlist=inf \
  --input-ipc-server="$SOCK" \
  --volume="$VOLUME" \
  --af=dynaudnorm=f=500:g=31:p=0.9:m=8:s=12,alimiter=limit=0.891:level=false \
  --no-video --no-input-terminal --msg-level=all=error,ao=v \
  "$PLAYLIST"
