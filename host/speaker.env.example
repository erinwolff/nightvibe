# Copy this file to speaker.env (which is gitignored) and set your Bluetooth
# speaker's MAC address. The host scripts source speaker.env at runtime; if it
# is absent they fall back to the placeholder below (which will not connect).
#
# Find your speaker's MAC with:  bluetoothctl devices
SPEAKER_MAC=AA:BB:CC:DD:EE:FF

# Optional: other BT speakers that, while connected, hog the adapter and stop
# the target from connecting. ensure-sink disconnects these (then retries) when
# the target won't connect. Space-separated MACs. Leave empty to disable.
BLOCKER_MACS=""
